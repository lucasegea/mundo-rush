{
  "name": "learning-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 apps packages scripts tooling eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "coverage:core": "vitest run --project @lg/core --coverage && node scripts/test/coverage-guard.ts",
    "validate:content": "node scripts/content/build.ts",
    "build:content": "node scripts/content/build.ts",
    "check:budgets": "node scripts/budgets/bundle-size.ts && npm run check:dev-only",
    "check:dev-only": "node -e \"console.log('check:dev-only: sentinel until FD0 (03 §6.5.1)')\"",
    "check:contrast": "node scripts/a11y/contrast.ts",
    "build": "tsc -b && npm run build --workspace @lg/web",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run coverage:core && npm run validate:content && npm run check:contrast && npm run build && npm run check:budgets"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
