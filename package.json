{
  "name": "learning-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 apps packages scripts tooling eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "coverage:core": "vitest run --project @lg/core --coverage && node scripts/test/coverage-guard.ts",
    "validate:content": "node scripts/content/build.ts",
    "build:content": "node scripts/content/build.ts",
    "assets:optimize": "node scripts/assets/optimize.ts",
    "check:budgets": "node scripts/budgets/bundle-size.ts && node scripts/assets/inspect-budgets.ts && npm run check:dev-only",
    "check:dev-only": "node scripts/budgets/dev-only.ts",
    "check:contrast": "node scripts/a11y/contrast.ts",
    "build": "tsc -b && npm run build --workspace @lg/web",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run coverage:core && npm run validate:content && npm run check:contrast && npm run build && npm run check:budgets",
    "dev:play": "npm run build:content && node scripts/dev/play.ts",
    "walk:browser": "node scripts/dev/browser-walk.ts",
    "perf:probe": "node scripts/dev/perf-probe.ts",
    "assets:refetch": "node scripts/assets/refetch.ts",
    "dev:reset-encounter": "node apps/server/src/reset-encounter.ts",
    "dev:reset-farmer": "node apps/server/src/reset-encounter.ts --npc NPC-HARLAN",
    "dev:director": "vite --config tooling/director/vite.config.ts",
    "director": "node tooling/director/src/cli.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "meshoptimizer": "1.3.0",
    "playwright-core": "~1.62.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
