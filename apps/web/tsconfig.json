{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../node_modules/.tsbuild/web",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "paths": {
      "@ui/*": ["./src/ui/*"],
      "@world/*": ["./src/world/*"],
      "@state/*": ["./src/state/*"],
      "@services/*": ["./src/services/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@teacher/*": ["./src/teacher/*"]
    }
  },
  "include": ["src", "src/**/*.json", "test"]
}
